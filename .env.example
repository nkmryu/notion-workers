# Notion Integration のトークン。対象データベースと 3 種類のテンプレートへアクセス権を付与すること。
NOTION_TOKEN=
# 日誌データベースの data source ID。database ID ではない。
# GET /v1/databases/{database_id} のレスポンスの data_sources[0].id で一度だけ取得して保存する。
NOTION_DATA_SOURCE_ID=
# 日次・週次・月次テンプレートのページ ID。
NOTION_TEMPLATE_ID=3a1372a1dbcd8014b380e2c11c3601d6
NOTION_WEEKLY_TEMPLATE_ID=3a1372a1dbcd801381e1e6db3c2adaa6
NOTION_MONTHLY_TEMPLATE_ID=3a2372a1dbcd80e9b00decd7e9c2c614
