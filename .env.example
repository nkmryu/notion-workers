# Notion Integration のトークン。日誌データベース・習慣データベースと日次テンプレートへアクセス権を付与すること。
NOTION_TOKEN=
# 日誌データベースの data source ID。database ID ではない。
# GET /v1/databases/{database_id} のレスポンスの data_sources[0].id で一度だけ取得して保存する。
NOTION_DATA_SOURCE_ID=
# 習慣データベースの data source ID。取得方法は NOTION_DATA_SOURCE_ID と同じ。
NOTION_HABIT_DATA_SOURCE_ID=
# 日次テンプレートのページ ID。
NOTION_TEMPLATE_ID=3a1372a1dbcd8014b380e2c11c3601d6
